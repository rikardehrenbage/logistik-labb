MODEL:

! Uppgift 2a: tilldelning av arbetsuppgifter;
! Xij = 1 om person i gör uppgift j, annars 0;

@BIN(X11); @BIN(X12); @BIN(X13); @BIN(X14); @BIN(X15); @BIN(X16);
@BIN(X21); @BIN(X22); @BIN(X23); @BIN(X24); @BIN(X25); @BIN(X26);
@BIN(X31); @BIN(X32); @BIN(X33); @BIN(X34); @BIN(X35); @BIN(X36);
@BIN(X41); @BIN(X42); @BIN(X43); @BIN(X44); @BIN(X45); @BIN(X46);

! Målfunktion: maximera total vinst;
MAX = 37000*X11 + 23000*X12 + 20000*X13 + 18000*X14 + 16000*X15 +  6000*X16
    + 25000*X21 + 14000*X22 + 14000*X23 + 18000*X24 + 17000*X25 +  8000*X26
    +  5000*X31 + 13000*X32 + 10000*X33 + 12000*X34 +  5000*X35 +  5000*X36
    + 10000*X41 +  3000*X42 + 13000*X43 +  7000*X44 +  2000*X45 + 16000*X46;

! Varje uppgift görs av högst en person;
X11 + X21 + X31 + X41 <= 1;
X12 + X22 + X32 + X42 <= 1;
X13 + X23 + X33 + X43 <= 1;
X14 + X24 + X34 + X44 <= 1;
X15 + X25 + X35 + X45 <= 1;
X16 + X26 + X36 + X46 <= 1;

! Tillgänglig tid per person (dagar per uppgift * antal uppgifter <= dagar);
2*X11 + 2*X12 + 2*X13 + 2*X14 + 2*X15 + 2*X16 <= 4;
3*X21 + 3*X22 + 3*X23 + 3*X24 + 3*X25 + 3*X26 <= 4;
3*X31 + 3*X32 + 3*X33 + 3*X34 + 3*X35 + 3*X36 <= 8;
4*X41 + 4*X42 + 4*X43 + 4*X44 + 4*X45 + 4*X46 <= 8;

END
